{
  "singleQuote": true,
  "semi": false,
  "tabWidth": 2,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "useTabs": false,
  "arrowParens": "always",
  "quoteProps": "as-needed",
  "printWidth": 80,
  "trailingComma": "none",
  "overrides": [
    {
      "files": "**/*.svelte",
      "options": {
        "plugins": ["prettier-plugin-svelte"],
        "parser": "svelte"
      }
    }
  ]
}
