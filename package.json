{
  "name": "chronous-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Midstem",
  "description": "Monorepo for Chronous: a headless scheduling engine and the adapters built on it",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midstem/chronous.git"
  },
  "bugs": {
    "url": "https://github.com/midstem/chronous/issues"
  },
  "homepage": "https://github.com/midstem/chronous#readme",
  "scripts": {
    "build": "npm run build --workspace @midstem/chronous --workspace @midstem/chronous-react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:run --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint --cache ./packages --quiet --fix",
    "lint:format": "prettier --write --log-level warn \"./**/*.{js,mjs,ts,tsx,css,md,json}\"",
    "lint-tsc": "npm run build --workspace @midstem/chronous && npm run lint:format && npm run lint:fix && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "temporal-polyfill": "^1.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "pre-commit": "lint-tsc"
}
