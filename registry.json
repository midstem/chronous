{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "chronous",
  "homepage": "https://midstem.github.io/chronous/",
  "items": [
    {
      "name": "chronous-calendar",
      "type": "registry:ui",
      "title": "Chronous Calendar",
      "description": "A customizable React calendar with day, week, month and agenda views, powered by Chronous and styled with your shadcn/ui theme.",
      "dependencies": [
        "@midstem/chronous-react@^1.0.2",
        "temporal-polyfill@^1.0.4"
      ],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "registry/default/chronous-calendar/chronous-calendar.tsx",
          "type": "registry:ui",
          "target": "@ui/chronous-calendar.tsx"
        },
        {
          "path": "registry/default/chronous-calendar/chronous-calendar/calendar.ts",
          "type": "registry:ui",
          "target": "@ui/chronous-calendar/calendar.ts"
        },
        {
          "path": "registry/default/chronous-calendar/chronous-calendar/events.tsx",
          "type": "registry:ui",
          "target": "@ui/chronous-calendar/events.tsx"
        },
        {
          "path": "registry/default/chronous-calendar/chronous-calendar/toolbar.tsx",
          "type": "registry:ui",
          "target": "@ui/chronous-calendar/toolbar.tsx"
        },
        {
          "path": "registry/default/chronous-calendar/chronous-calendar/views.tsx",
          "type": "registry:ui",
          "target": "@ui/chronous-calendar/views.tsx"
        }
      ]
    }
  ]
}
