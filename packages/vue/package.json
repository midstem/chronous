{
  "name": "@midstem/chronous-vue",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Headless Vue primitives for @midstem/chronous",
  "author": "Midstem",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*/index.ts"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midstem/chronous.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/midstem/chronous/issues"
  },
  "homepage": "https://github.com/midstem/chronous#readme",
  "keywords": [
    "vue",
    "calendar",
    "scheduler",
    "headless",
    "composables",
    "typescript"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "node ../../tools/scripts/prepack.mjs"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@midstem/chronous": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
